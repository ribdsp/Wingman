# Wingman web — the operator console
#
# Copy to .env.local and fill in. Placeholders read CHANGE_ME so that a half-configured
# console says which variable is missing instead of quietly talking to nothing. Every
# problem is reported at once, in the console's log, the first time a request needs the
# configuration.
#
# This app holds no data of its own. It renders what the two Go services say and
# forwards what an operator does back to them. Everything below is either where to
# find them or how to keep a credential out of the browser.

# ---- Where the services are ----------------------------------------------------
# Reached from the Node server, never from the browser: these may be private
# addresses on a docker network or a VPN, and nothing here is published.
GOAL_ENGINE_BASE_URL=http://127.0.0.1:8080
CORE_BASE_URL=http://127.0.0.1:8081

# ---- The console's own credential ----------------------------------------------
# A goal-engine BOT key — one listed in GOAL_ENGINE_BOT_KEYS, not in
# GOAL_ENGINE_API_KEYS. This is the ceiling the console runs at when nobody is
# holding operator authority: it can read goals, pace, approvals and the audit log,
# and it can ENGAGE the kill switch. It cannot release it, resolve an approval or
# move a target — the engine refuses those to a bot key, and that refusal is the
# reason this is a bot key.
#
# There is deliberately no GOAL_ENGINE_OPERATOR_KEY here. An operator key sitting in
# a web server's environment is an operator key that any request-handling bug can
# use; the operator pastes theirs when they need it and it is held, encrypted, in
# their own cookie for WEB_OPERATOR_TTL_MINUTES.
GOAL_ENGINE_BOT_KEY=CHANGE_ME

# ---- Cookie encryption ---------------------------------------------------------
# 32 bytes, base64 or hex. Seals the two things this app keeps in a cookie: a signed-in
# person's core session token, and an operator's pasted key. Both are httpOnly and
# AES-256-GCM sealed, so a cookie read off disk or out of a proxy log is not a usable
# credential.
#
# Generate one:  openssl rand -base64 32
# Rotating it signs everybody out, which is the correct behaviour for a secret whose
# only job is to make old cookies unreadable.
WEB_COOKIE_SECRET=CHANGE_ME

# ---- How long operator authority lasts -----------------------------------------
# Minutes. Short on purpose, and shown as a countdown in the console: authority you
# forgot you were holding is authority somebody else can use on your laptop.
# Floor 1, ceiling 480.
WEB_OPERATOR_TTL_MINUTES=30

# ---- Polling -------------------------------------------------------------------
# Core streams nothing — there is no SSE and no websocket, because every channel
# connection it makes is outbound and it has no inbound route at all. The console
# therefore polls. Milliseconds; floor 1000.
WEB_POLL_INTERVAL_MS=4000

# How long to wait on either service before giving up. A dashboard that hangs is a
# dashboard nobody trusts; better to show that a read failed. Milliseconds; floor 1000.
WEB_UPSTREAM_TIMEOUT_MS=15000

# ---- Serving -------------------------------------------------------------------
# Bind to loopback and put it behind your own TLS. Nothing in this console expects to
# face the internet directly.
PORT=3000
HOSTNAME=127.0.0.1
