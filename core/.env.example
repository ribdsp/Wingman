# Wingman core — environment
#
# Copy to .env and fill in. Every value below is read once at startup and validated;
# the process reports every problem at once and refuses to boot half-configured, so a
# typo here is cheap. A credential discovered missing four tool calls into a run is not.
#
# Nothing in this file may be committed once filled in. .env is gitignored.

# ---- Process -------------------------------------------------------------
APP_ENV=development           # production switches logging to JSON
PORT=8081                     # 8081, not 8080: the goal engine has 8080
LOG_LEVEL=info                # trace debug info warn error
TIMEZONE=Asia/Jakarta         # every rendered timestamp uses this zone
SHUTDOWN_GRACE=30s            # in-flight requests and running workers get this long

# ---- This service's own database ----------------------------------------
# Separate from the goal engine's on purpose. This one holds accounts, chats and
# transcripts; that one holds the audit trail and the approval queue. Losing one
# should not mean losing the other.
DATABASE_URL=postgres://wingman:CHANGE_ME@localhost:5432/wingman_core?sslmode=disable
AUTO_MIGRATE=true             # applies migrations/ on boot
MIGRATIONS_DIR=migrations

# ---- Accounts ------------------------------------------------------------
# Registration is closed by default, and that default is a safety property: a
# self-hosted box found on the internet with open sign-up is a box running strangers'
# code in your sandbox on your API key.
#
# Make the first account from the shell instead. The password is read from standard
# input rather than a flag, so it stays out of the process list and shell history:
#
#   read -rs CORE_PASSWORD && printf '%s' "$CORE_PASSWORD" | \
#     ./core createuser -email you@example.com -name 'Your Name'
CORE_OPEN_REGISTRATION=false
SESSION_TTL=168h              # minimum 15m, maximum 90 days

# ---- Machine credentials -------------------------------------------------
# Two lists, two privilege levels. Which list a key is in is the ONLY thing that
# decides what it may do — never a request header, never a body. A human user is in
# neither: users live in the database, and no environment key can become one.
#
# Operator keys are yours. Only an operator may cancel another person's run, read
# another person's transcript, or read the whole run log.
#
# Bot keys are for services — in practice the goal engine's trigger bridge. A bot may
# file a task and read what it filed. It cannot read a user's chats.
#
# Format: comma-separated, each entry "name:secret" or a bare secret. The name is what
# the audit log records, so name them after who they are: an entry that can only say
# "some valid key" does not answer "who cancelled that run". A bare secret is labelled
# with a short hash of itself. Minimum 24 characters; a secret must not contain a colon.
CORE_API_KEYS=ops:CHANGE_ME_operator_key_at_least_24_chars
CORE_BOT_KEYS=goal-engine:CHANGE_ME_bot_key_at_least_24_chars

# The account that work nobody asked for is filed against and billed to.
#
# Required as soon as CORE_BOT_KEYS is set, and deliberately without a default: a
# goal-engine trigger has no person behind it, and a run with no owner is a run whose
# tokens appear in no ledger and whose transcript nobody can find. Resolved to an
# account id once at boot, so a typo here stops the process rather than the first
# dispatch. Make the account with `core createuser` first.
CORE_UNATTENDED_OWNER=you@example.com

# ---- Model providers -----------------------------------------------------
# Both SDKs are compiled in; DEFAULT_PROVIDER decides which one a run uses, and only
# that provider's key is required.
DEFAULT_PROVIDER=anthropic    # anthropic | openai
DEFAULT_MODEL=CHANGE_ME_model_id

ANTHROPIC_API_KEY=CHANGE_ME_anthropic_key
# OPENAI_API_KEY=CHANGE_ME_openai_key

# DEFAULT_MODEL has no default in code, on purpose. Vendors retire model ids on their
# own schedule, and a constant baked into a release fails at the first model call with
# a message about the vendor rather than about this file. Put the id you are paying for
# here — anthropic wants a name like claude-sonnet-4-5, openai one like gpt-5.

# ---- Sandbox -------------------------------------------------------------
# Where a tool call actually executes.
#
# docker is the one to run in front of other people: a throwaway container per command,
# no network unless you grant it, no capabilities, read-only root, a memory and a pid
# limit. local runs the script on this host as the user this service runs as — it is not
# isolation and does not pretend to be, and it exists so a laptop with no docker daemon
# can still drive a run end to end.
#
# Never local inside the container image: a generated script would then run in the same
# container that holds these API keys and the docker socket.
SANDBOX_BACKEND=docker        # docker | local
SANDBOX_WORKSPACE_ROOT=workspaces

# The image a tool call runs in. Nothing publishes wingman/sandbox — replace this with
# an image you trust and whose toolchain the work needs: alpine:3.22 for shell work,
# python:3.13-alpine, node:22-alpine, or your own. It is a filesystem here rather than
# an application: the entrypoint is replaced with sh, so whatever the image declares is
# not what runs.
SANDBOX_IMAGE=wingman/sandbox:latest

# none means the sandbox cannot reach the internet or your other containers. A sandbox
# with network access is a different threat model, so it is something you turn on
# deliberately — and once on, a generated script can reach anything the host can.
SANDBOX_NETWORK=none
SANDBOX_MEMORY=512m

# ---- Operator-owned tool declarations -----------------------------------
# What an agent may do lives in these three files, and there is no API that writes any
# of them — the same rule the goal engine applies to metric definitions, for the same
# reason. All three ship declaring nothing, so a fresh instance can think and answer
# but cannot act until you say what it may do.
TOOLS_CONFIG_PATH=config/tools.yaml
MCP_CONFIG_PATH=config/mcp.yaml
HTTP_TOOLS_CONFIG_PATH=config/http-tools.yaml

# ---- Run limits ----------------------------------------------------------
# Every one of these is optional, and every default is restrictive. Omitting one never
# means "no limit": zero reads as unset and the shipped default is applied, because a
# loop with no iteration cap and no token allowance bills by the second.
#
# Commented out below are the defaults, with their hard bounds. An operator who raises
# one is making a decision; an operator who leaves a line out is not.
# RUN_MAX_ITERATIONS=15        # how many times one run may ask the model. 1-200
# RUN_MAX_TOOL_CALLS=40        # side effects, not thought. 1-500
# RUN_MAX_TOKENS=250000        # one run's allowance. 1000-10000000
# USER_DAILY_TOKEN_CAP=2000000 # one person's allowance today, across every run.
#                              # -1 removes it, written out, and nothing else does
# RUN_STEP_TIMEOUT=3m          # bounds one model call. 5s-15m
# SANDBOX_TIMEOUT=90s          # bounds one tool execution. 1s-30m

# ---- Run workers ---------------------------------------------------------
# Each worker is a concurrent model conversation with a container behind it, so this is
# how many runs can be in flight at once and how much you can be spending at once.
RUN_WORKERS=2                 # 1-64
RUN_QUEUE_POLL=5s             # minimum 1s

# ---- The goal engine -----------------------------------------------------
# Leave GOAL_ENGINE_BASE_URL empty and core runs standalone: no kill switch, and no
# tool call may spend money, because the gate that would approve one is the engine's.
#
# Set it and two things become true. Every run checks the kill switch before it starts
# and between iterations, fail-closed — unreadable means engaged, engaged means halt.
# And every spending tool call files a request with the engine's approval ladder rather
# than being decided here; core has no second, weaker gate.
#
# This key is a BOT key on the goal engine — GOAL_ENGINE_BOT_KEYS over there, not
# GOAL_ENGINE_API_KEYS. Core asks permission to spend; it does not grant it.
GOAL_ENGINE_BASE_URL=http://localhost:8080
GOAL_ENGINE_API_KEY=CHANGE_ME_goal_engine_bot_key
GOAL_ENGINE_TIMEOUT=15s

# Reports each run's token usage as a push sample, so cost becomes a metric a goal can
# be written against. Defaults to on whenever a base URL is set. The metric has to be
# declared in the engine's config/metrics.yaml as a push metric of this name.
GOAL_ENGINE_REPORT_SPEND=true
GOAL_ENGINE_SPEND_METRIC=ops.tokens_spent

# ---- Chat platforms ------------------------------------------------------
# Leave all four blank and core listens on no chat platform, which is the default: it is
# reached over HTTP by a client and by the goal engine. Fill in a token and this instance
# connects to that platform on boot.
#
# Every connection here is OUTBOUND — Telegram long polling, Slack's Socket Mode socket,
# Discord's gateway — so none of this needs a public address, a certificate, an inbound
# port, or a route that verifies somebody else's request signature. A box behind a home
# router works with nothing forwarded.
#
# A chat account can do nothing until a person links it to their Wingman account. They
# ask the app for a link code and send that code to the bot; the code is minted once,
# stored only as a hash, and is the only thing that attaches an account. An unlinked
# chat is told how to link and nothing else — it never reaches the agent, and every run
# a linked chat starts is billed to the person who linked it.
#
# Telegram: a token from @BotFather. Leave the BotFather privacy setting ON, which is
# the default — it means the bot only sees group messages that mention it, matching what
# core will act on anyway.
# CHANNEL_TELEGRAM_TOKEN=CHANGE_ME_telegram_bot_token
#
# Slack needs both of its tokens, because they are issued separately and do different
# jobs: the xoxb- bot token talks to the Web API, the xapp- app-level token opens the
# socket. One without the other is refused at boot rather than failing as a 401 when the
# socket opens. Turn Socket Mode on, subscribe the app to message.im and app_mention,
# and give it chat:write, im:history and app_mentions:read.
# CHANNEL_SLACK_BOT_TOKEN=CHANGE_ME_xoxb_bot_token
# CHANNEL_SLACK_APP_TOKEN=CHANGE_ME_xapp_app_level_token
#
# Discord: a bot token from the developer portal, plus the MESSAGE CONTENT intent
# enabled there. It is privileged, and without it every message arrives with an empty
# body. Core asks for three intents and no more — guild messages, direct messages,
# message content — because an intent not asked for is data that never reaches this
# process.
# CHANNEL_DISCORD_TOKEN=CHANGE_ME_discord_bot_token

# How long a link code stays redeemable. Minimum 1m, maximum 1h. It is a bearer
# credential: whoever sends it from a chat account attaches that account to whoever
# minted it, so the window is short on purpose and a code left in a scrollback is
# already dead. Asking for a new one invalidates the outstanding one.
CHANNEL_LINK_CODE_TTL=15m

# The shortest gap between two messages accepted from one sender. Minimum 1s, and zero
# is refused rather than read as "no throttle": every accepted message is a run, and a
# run spends the linked person's tokens.
CHANNEL_MIN_INTERVAL=1s

# Whether a message from a shared room may reach the agent, off by default. In a group
# the linked person's token budget is spendable by anybody who can type there, and the
# run is filed against them. Turn it on for a room you trust — and note that core still
# only acts on a group message that mentions the bot.
CHANNEL_ALLOW_GROUPS=false

# ---- Network -------------------------------------------------------------
# Set this when a reverse proxy or load balancer sits in front of the service. Left
# empty, the rate limiter keys on the peer address; behind a proxy that means every
# caller shares one bucket. Set wrongly, a client can set its own X-Forwarded-For and
# choose its bucket.
TRUSTED_PROXIES=
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=30

# ---- Running under docker compose ---------------------------------------
# Nothing else belongs in this file. The database name, the published port, the
# workspace path on the host and the docker group are the stack's settings rather than
# this service's, and they live in deploy/.env.example — copied to deploy/.env, which
# compose reads and does not hand to any container.
#
# Under compose, three values above are overridden: DATABASE_URL, because inside that
# network the database is "core-db" and not the localhost above; PORT; and
# SANDBOX_WORKSPACE_ROOT, which becomes the absolute host path the sandbox is mounted
# from, identical inside and outside the container.
