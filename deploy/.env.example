# Wingman — the compose stack's own environment.
#
# Copy to .env. This file is read by docker-compose.yml itself, to name the databases,
# build each DATABASE_URL, and decide which host ports to publish. It is deliberately
# NOT handed to any container: each service gets its own file.
#
#   cd deploy
#   cp .env.example                 .env
#   cp ../goal-engine/.env.example  .env.goal-engine
#   cp ../core/.env.example         .env.core
#   cp ../web/.env.example          .env.web
#
# Four files rather than one, because the whole point of running the services apart is
# that breaking into one of them is not breaking into all. A shared file mounted
# everywhere would put the goal engine's operator keys inside core and inside the web
# console — and both are clients of the engine's API, not peers. They ask to spend; they
# must not be holding the credential that approves.
#
# Neither password below has a default in docker-compose.yml. Compose refuses to start
# without one rather than fall back to something guessable.

# ---- The goal engine's database ------------------------------------------
POSTGRES_DB=wingman_goals
POSTGRES_USER=wingman
POSTGRES_PASSWORD=CHANGE_ME_goal_database_password

# ---- Core's database -----------------------------------------------------
# A second Postgres, not a second schema. That one holds the audit trail and the
# approval queue; this one holds accounts, chats and transcripts. Losing one should
# not mean losing the other.
CORE_POSTGRES_DB=wingman_core
CORE_POSTGRES_USER=wingman
CORE_POSTGRES_PASSWORD=CHANGE_ME_core_database_password

# ---- Published ports -----------------------------------------------------
# All three are bound to 127.0.0.1 in the compose file. Put a reverse proxy in front and
# set TRUSTED_PROXIES in the service's own file rather than widening these.
#
# In normal use only the console needs to be reachable by a person; the two APIs are
# published because an operator wants curl and psql to work from the box, not because
# anything else should be able to reach them.
GOAL_ENGINE_PORT=8080
CORE_PORT=8081
WEB_PORT=3000

# ---- Core's sandbox ------------------------------------------------------
# The workspace directory, as an absolute path on the host.
#
# It is mounted at the same path inside core's container, and that is not a style
# choice. With SANDBOX_BACKEND=docker, core asks the HOST's daemon to mount a
# workspace, and the daemon resolves that path against the host's filesystem — so the
# path core knows has to be the path the host has. A named volume, or a different path
# inside, gives the sandbox an empty /workspace and an agent that finds nothing.
#
# Create it before the first `up`, owned by the uid core runs as — the image builds an
# unprivileged user at a fixed 65532 precisely so this is predictable:
#
#   sudo mkdir -p /srv/wingman/workspaces
#   sudo chown 65532:65532 /srv/wingman/workspaces
CORE_WORKSPACE_DIR=/srv/wingman/workspaces

# The group that owns /var/run/docker.sock on the host, so core can reach the daemon
# without running as root. On most Linux hosts:
#
#   stat -c '%g' /var/run/docker.sock
#
# Membership of that group is root-equivalent on the host — see SECURITY.md's known
# limitations before you decide this stack belongs on a box with anything else on it.
CORE_DOCKER_GID=999

# ---- Images --------------------------------------------------------------
# Tag to build and run, for all three services. Leave as dev unless you are releasing.
WINGMAN_VERSION=dev
