# ---- Secrets / environment ----------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
!**/testdata/**/*.key
secrets/
keys/

# ---- Private product documents -------------------------------------------
# The original PRD names products, people and infrastructure that are nobody
# else's business. Its public, redacted equivalent is docs/motivation.md, and
# that is the one to keep in step with the code.
PRD.md

# ---- Go ------------------------------------------------------------------
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.out
coverage.html
vendor/

# ---- Node / TypeScript ---------------------------------------------------
node_modules/
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Docker / runtime volumes -------------------------------------------
deploy/data/
deploy/volumes/
*.pid
*.log

# Sandbox workspaces: whatever an agent wrote while working. Per user, never
# shared, and never somebody else's business.
core/workspaces/

# ---- OS / editor ---------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# ---- Local agent scratch space ------------------------------------------
.claude/settings.local.json
tmp/
scratch/
# Written wherever a browser-automation tool is pointed, one directory per run.
.playwright-mcp/
# Screenshots taken while measuring the console land in the working directory
# when the tool is handed a bare filename. Root only, so docs/ and web/public/
# may still carry a real image.
/*.png
