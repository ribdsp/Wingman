# Wingman goal engine — environment
#
# Copy to .env and fill in. Every value below is read once at startup and
# validated; the process refuses to boot half-configured rather than discover a
# missing credential mid-decision, so a typo here is cheap.
#
# Nothing in this file may be committed once filled in. .env is gitignored.

# ---- Process -------------------------------------------------------------
APP_ENV=development           # production switches logging to JSON
PORT=8080
LOG_LEVEL=info                # trace debug info warn error
TIMEZONE=Asia/Jakarta         # every rendered timestamp uses this zone
SHUTDOWN_GRACE=20s            # how long in-flight requests get to finish

# ---- This service's own database ----------------------------------------
# Separate from the core's database on purpose: the goal engine keeps the audit
# trail and the approval queue, and it should survive a core upgrade untouched.
DATABASE_URL=postgres://wingman:CHANGE_ME@localhost:5432/wingman_goals?sslmode=disable
AUTO_MIGRATE=true             # applies migrations/ on boot
MIGRATIONS_DIR=migrations

# ---- Operator-owned config files ----------------------------------------
# Neither is writable through the API. See the comments in each file for why.
METRICS_CONFIG_PATH=config/metrics.yaml
POLICIES_CONFIG_PATH=config/policies.yaml

# ---- Credentials ---------------------------------------------------------
# Two lists, two privilege levels. Which list a key is in is the ONLY thing that
# decides what it may do — never a request header, never a body.
#
# Operator keys are yours. Only an operator may resolve an approval, release the
# kill switch, or rewrite a goal's target.
#
# Bot keys are for agents and cron jobs. A bot may state goals, read, report
# metric values, and ask permission to spend. It cannot grant itself any of that.
#
# Format: comma-separated, each entry "name:secret" or a bare secret. The name is
# what the audit log records, so name them after who they are: an entry that can
# only say "some valid key" does not answer "who moved that target". A bare secret
# is labelled with a short hash of itself. Minimum 24 characters; a secret must
# not contain a colon.
GOAL_ENGINE_API_KEYS=ops:CHANGE_ME_operator_key_at_least_24_chars
GOAL_ENGINE_BOT_KEYS=wingman-core:CHANGE_ME_bot_key_at_least_24_chars,web-console:CHANGE_ME_console_key_at_least_24_chars,billing-feed:CHANGE_ME_feed_key_at_least_24_chars

# Give each external metric feed its own bot key rather than reusing the one an
# agent thinks with: a reported value is exactly as trustworthy as the credential
# that sent it, and one key per feed is what makes a wrong number traceable.
#
# The same rule is why the console has its own entry above rather than core's. Two
# principals may not share a secret — startup refuses it — and the console reads
# every screen an operator looks at, so "who read that" and "what core did" should
# not be the same line in the audit log. Its secret goes in web/.env.local as
# GOAL_ENGINE_BOT_KEY. A bot key there is deliberate: the console may engage the
# kill switch and read everything, and nothing more.

# ---- Network -------------------------------------------------------------
# Set this when a reverse proxy or load balancer sits in front of the service.
# Left empty, the rate limiter keys on the peer address; behind a proxy that
# means every caller shares one bucket. Set wrongly, a client can set its own
# X-Forwarded-For and choose its bucket.
TRUSTED_PROXIES=
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=30

# ---- Wingman core --------------------------------------------------------
# Where a triggered goal becomes a task an agent picks up. Core listens on 8081;
# this service has 8080.
WINGMAN_CORE_BASE_URL=http://localhost:8081
# This value must appear in core's CORE_BOT_KEYS as `goal-engine:<secret>`. Over
# there it is a bot credential, not an operator one: the engine dispatches work
# and reports its own token spend, and neither needs operator privilege.
WINGMAN_CORE_API_KEY=CHANGE_ME_core_api_key
WINGMAN_CORE_TIMEOUT=30s
# WINGMAN_CORE_TASK_PATH=/api/tasks     # only if core moved the route

# Used when a goal names no bot of its own.
WINGMAN_DEFAULT_BOT_ID=
WINGMAN_DEFAULT_CHANNEL_ID=

# Start here. With dry run on, goals are evaluated, decisions are recorded and
# the audit log fills up, but no task reaches core — so you can read a week of
# what the engine wanted to do before letting it do any of it.
TRIGGER_DRY_RUN=true

# ---- Notifications -------------------------------------------------------
# Off by default, like dry run above. Turned on, two moments produce one short
# message on a chat platform you already use: a trigger was dispatched, and a
# spend came back `pending` and is waiting for you. `auto_approved` and `denied`
# send nothing — a decision that made itself is not news.
#
# The engine owns no channel stack. It posts one line to core, which already
# holds Telegram, Slack and Discord, and core sends it to whichever chat
# accounts CORE_UNATTENDED_OWNER has linked. There is deliberately no recipient
# in the request and nothing here to point at a person: a field naming who to
# message would let anything holding a bot key send a message from your instance
# to any chat account linked to it.
#
# So there is one manual step, once: sign in as the account CORE_UNATTENDED_OWNER
# names, mint a link code, and redeem it from the chat account that should get
# these. Until then this is on and reaching nobody, and core says so —
# "recipients: 0", which the engine logs.
NOTIFY_ENABLED=false

# Where the console is reachable, used to build the link in the message. Must
# start with http:// or https:// or the process refuses to boot; a trailing slash
# is trimmed.
#
# The link is the whole point. A notification carries no amount, no currency and
# no pace figure — a chat message is retained on somebody else's servers, and a
# message complete enough to decide from is one people decide from at a glance,
# without the policy or the day's total in front of them. Left empty the message
# still goes out, without a link rather than with a broken one, which means being
# told to go and look at something without being told where. Set it.
WEB_BASE_URL=
# WINGMAN_CORE_NOTIFY_PATH=/v1/notifications   # only if core moved the route

# Nothing about notifications is retried and nothing is queued. A failure is
# logged and dropped, exactly like a failed audit write: by then the decision it
# describes has already happened. A lost message costs a prompt, never a
# decision — the approval is still in the queue, the console still shows it, and
# APPROVAL_TTL below still expires it.

# ---- Monitor -------------------------------------------------------------
MONITOR_ENABLED=true
MONITOR_INTERVAL=1h           # minimum 1m; POST /v1/monitor/tick runs one now
MONITOR_MAX_GOALS_PER_TICK=200
METRIC_SAMPLE_TIMEOUT=15s     # bounds one metric query or fetch

# How stale the last reported value of a push metric may be before goals
# measured on it stop being evaluated. A dead feed leaves its last number in
# place, and a goal judged on that number looks exactly as on-track as it did
# when the feed stopped. The default allows a daily job that ran late.
METRIC_MAX_SAMPLE_AGE=26h

# ---- Approvals -----------------------------------------------------------
# How long a spend request waits for a human before it expires. Long enough that
# you can sleep through one; short enough that a stale ask is not approved hours
# after the moment it was about.
APPROVAL_TTL=24h

# ---- Referenced from config/metrics.yaml --------------------------------
# Only needed once you declare a sql or http metric. Keep DSNs read-only.
# METRIC_DSN_BILLING=postgres://readonly:CHANGE_ME@localhost:5432/billing?sslmode=disable
# METRIC_AUTH_ANALYTICS=Bearer CHANGE_ME

# ---- Running under docker compose ---------------------------------------
# Nothing else belongs in this file. The database name, the published port and the
# image tag are the stack's settings rather than this service's, and they live in
# deploy/.env.example — copied to deploy/.env, which compose reads and does not hand
# to any container.
#
# Under compose, DATABASE_URL above is overridden: inside that network the database is
# "goal-db", and a URL copied from a developer's machine would point at a localhost
# that means the container itself.
